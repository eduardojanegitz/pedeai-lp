---
import { Check, MessageCircle, Mail } from 'lucide-react';
import { plans } from '../../data/plans';

const phone = (import.meta.env.PUBLIC_WHATSAPP ?? '').replace(/\D/g, '');
const email = import.meta.env.PUBLIC_EMAIL ?? '';
const msg = 'Olá! Vi o PedeAí! e quero conversar sobre os planos.';
const whatsapp = phone ? `https://wa.me/${phone}?text=${encodeURIComponent(msg)}` : '';
const mail = email ? `mailto:${email}?subject=${encodeURIComponent('Quero conhecer o PedeAí!')}&body=${encodeURIComponent(msg)}` : '';
---
<section id="planos" class="mx-auto max-w-6xl px-4 py-20">
  <h2 class="text-5xl md:text-6xl">Planos e conversa</h2>
  <p class="mt-3 max-w-2xl text-lg font-medium text-muted-foreground">O PedeAí! é uma ferramenta nova. Em vez de uma tabela fria, a gente conversa e indica o melhor caminho para o seu caso.</p>

  {plans.length > 0 && (
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {plans.map((p) => (
        <article class:list={['pop-card flex flex-col p-6', p.highlight && 'pop-card-lg bg-accent']}>
          <h3 class="text-4xl">{p.name}</h3>
          <p class="mt-1 font-display text-2xl text-primary">{p.price ?? 'Fale conosco para valores'}</p>
          <p class="mt-2 font-medium text-muted-foreground">{p.description}</p>
          <ul class="mt-4 space-y-2 text-sm font-semibold">
            {p.features.map((f) => <li class="flex gap-2"><Check class="mt-0.5 size-4 shrink-0 text-secondary" aria-hidden="true" />{f}</li>)}
          </ul>
        </article>
      ))}
    </div>
  )}

  <div class:list={['pop-card pop-card-lg bg-secondary p-8 text-secondary-foreground md:p-10', plans.length > 0 ? 'mt-8' : 'mt-10']}>
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <h3 class="text-4xl md:text-5xl">Interessou? Vamos conversar.</h3>
        <p class="mt-2 max-w-xl font-medium opacity-90">Conte como você organiza os pedidos hoje. A gente mostra o PedeAí! funcionando e combina o plano que faz sentido.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        {whatsapp && <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="pop-press inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-bold text-accent-foreground"><MessageCircle aria-hidden="true" />Falar no WhatsApp</a>}
        {mail && <a href={mail} class="pop-press inline-flex items-center gap-2 rounded-full bg-card px-6 py-3 font-bold text-foreground"><Mail aria-hidden="true" />Enviar e-mail</a>}
      </div>
    </div>
  </div>
</section>
